<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Serveur Web"
            android:textColor="#38BDF8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Version 1.0.0 - Production"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E293B"
            android:padding="16dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DÉVELOPPEUR OFFICIEL :"
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDevName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arsène KAPEND A KALEND"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDevCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Solution"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginVertical="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact / WhatsApp / Airtel Money :"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDevPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+243 977 811 446"
                android:textColor="#F8FAFC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginVertical="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Basé à :"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDevLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lubumbashi / Kolwezi, RDC"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginVertical="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notre Mission :"
                android:textColor="#22C55E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDevMission"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Créer des outils numériques qui marchent SANS INTERNET"
                android:textColor="#F8FAFC"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#334155"
                android:layout_marginVertical="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plateforme en ligne :"
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDevWebsite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="https://smartsolution-jq7ceh5rya-nw.a.run.app"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Actions de contact direct -->
        <Button
            android:id="@+id/btnWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Écrire sur WhatsApp (+243 977 811 446)"
            android:backgroundTint="#22C55E"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCallPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Appeler / Airtel Money"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnOpenWebsite"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Visiter Smart Solution Platform"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
