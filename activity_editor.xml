<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp">

    <!-- Barre d'outils de l'éditeur -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvCurrentFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="index.php"
            android:textColor="#38BDF8"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnOpenFile"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Ouvrir"
            android:textSize="12sp"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnNewFile"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Nouveau"
            android:textSize="12sp"
            android:backgroundTint="#475569"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSaveFile"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Sauvegarder"
            android:textSize="12sp"
            android:backgroundTint="#22C55E"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <EditText
        android:id="@+id/etCodeContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:background="#020617"
        android:padding="12dp"
        android:textColor="#F8FAFC"
        android:fontFamily="monospace"
        android:textSize="13sp"
        android:inputType="textMultiLine"
        android:scrollbars="vertical|horizontal" />

</LinearLayout>
