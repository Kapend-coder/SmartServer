<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- En-tête : Titre exigé -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Serveur Web - by Smart Solution"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nginx 8080 • PHP 8.2 • MariaDB 3306 • FTP 2121"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Statut et Adresse IP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E293B"
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Statut :"
                android:textColor="#CBD5E1"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Arrêté"
                android:textColor="#EF4444"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#334155"
            android:layout_marginVertical="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Adresse Web (cliquable) :"
                android:textColor="#CBD5E1"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPortLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Port: "
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvPortNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8080"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="http://127.0.0.1:8080"
            android:textColor="#22C55E"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="6dp" />
    </LinearLayout>

    <!-- Gros Bouton Vert START et Gros Bouton Rouge STOP -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:text="START"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#22C55E"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="62dp"
            android:layout_weight="1"
            android:text="STOP"
            android:textSize="20sp"
            android:textStyle="bold"
            android:backgroundTint="#EF4444"
            android:textColor="#FFFFFF"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Boutons d'accès rapides : phpMyAdmin, htdocs, Logs, Éditeur, À propos -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="3"
        android:layout_marginBottom="10dp">

        <Button
            android:id="@+id/btnOpenPhpMyAdmin"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:text="Ouvrir phpMyAdmin"
            android:textSize="12sp"
            android:backgroundTint="#0284C7"
            android:textColor="#FFFFFF"
            android:layout_margin="3dp" />

        <Button
            android:id="@+id/btnOpenHtdocs"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:text="Ouvrir htdocs"
            android:textSize="12sp"
            android:backgroundTint="#475569"
            android:textColor="#FFFFFF"
            android:layout_margin="3dp" />

        <Button
            android:id="@+id/btnOpenEditor"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:text="Éditeur de texte"
            android:textSize="12sp"
            android:backgroundTint="#6366F1"
            android:textColor="#FFFFFF"
            android:layout_margin="3dp" />

        <Button
            android:id="@+id/btnViewLogs"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="1"
            android:text="Voir les logs"
            android:textSize="12sp"
            android:backgroundTint="#334155"
            android:textColor="#FFFFFF"
            android:layout_margin="3dp" />

        <Button
            android:id="@+id/btnAbout"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_columnWeight="2"
            android:text="À propos (Smart Solution)"
            android:textSize="12sp"
            android:backgroundTint="#0F766E"
            android:textColor="#FFFFFF"
            android:layout_margin="3dp" />
    </GridLayout>

    <!-- Logs qui défilent en bas -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CONSOLE EN DIRECT :"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:id="@+id/scrollViewLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#020617"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvLogsStream"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[READY] Smart Serveur Web initialisé. Appuyez sur START."
            android:textColor="#22C55E"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
