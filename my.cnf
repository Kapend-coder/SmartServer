# Configuration MariaDB pour Smart Serveur Web
# Réalisé par Arsène KAPEND A KALEND (Smart Solution)

[mysqld]
user = root
port = 3306
basedir = /data/user/0/com.smartsolution.smartserveurweb/files
datadir = /data/user/0/com.smartsolution.smartserveurweb/files/mariadb_data
socket = /data/user/0/com.smartsolution.smartserveurweb/files/mysql.sock
bind-address = 0.0.0.0
pid-file = /data/user/0/com.smartsolution.smartserveurweb/files/mysqld.pid
tmpdir = /data/user/0/com.smartsolution.smartserveurweb/files/tmp
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
default-storage-engine = InnoDB
max_connections = 50
query_cache_size = 16M
table_open_cache = 400
innodb_buffer_pool_size = 32M
innodb_log_file_size = 8M

[client]
port = 3306
socket = /data/user/0/com.smartsolution.smartserveurweb/files/mysql.sock
default-character-set = utf8mb4
